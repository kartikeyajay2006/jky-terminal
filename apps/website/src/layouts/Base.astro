---
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "../styles/global.css";
import monoFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import textFont from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import { themeTokens } from "../lib/facts";
import { DEFAULT_THEME, THEME_BOOT } from "../lib/theme";

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search results (the 404, the share card). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site);
// The browser chrome's colour is the default theme's ground — read from the
// app's tokens like every other colour, never typed in.
const ground = themeTokens()[DEFAULT_THEME]["--ground"];
const shareImage = new URL(`${base}og.png`, Astro.site);
// Structured data: what the page is about, for search engines that read it.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JKY Terminal",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux",
  description,
  license: "https://opensource.org/licenses/MIT",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  url: new URL(base, Astro.site).href,
  downloadUrl: "https://github.com/kartikeyajay2006/jky-terminal/releases/latest",
  author: { "@type": "Person", name: "kartikeyajay2006", url: "https://github.com/kartikeyajay2006" },
});
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={ground} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JKY Terminal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JKY Terminal — close the window, the build keeps going." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={jsonLd} />
    <!-- Before first paint: the saved theme (no flash of the default), and the
         `js` class that lets CSS stage entrances only when scripts run. -->
    <script is:inline set:html={THEME_BOOT} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
