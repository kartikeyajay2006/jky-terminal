---
import Mark from "./Mark.astro";
import ThemePicker from "./ThemePicker.astro";
import { GITHUB, DOCS } from "../lib/links";

interface Props {
  version: string;
}

const { version } = Astro.props;
// With the trailing slash: Pages answers /jky-terminal with a redirect.
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__brand" href={home} aria-label="JKY Terminal, home">
      <Mark size={28} />
      <span class="nav__name">JKY Terminal</span>
      <span class="nav__version">v{version}</span>
    </a>

    <nav class="nav__links" aria-label="Site">
      <a href="#try">Try it</a>
      <a href="#persist">Features</a>
      <a href="#security">Security</a>
      <a href="#themes">Themes</a>
      <a href="#compare">Compare</a>
      <a href={DOCS}>Docs</a>
    </nav>

    <div class="nav__end">
      <ThemePicker />
      <a class="nav__github" href={GITHUB} aria-label="JKY Terminal on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      <a class="btn btn--primary btn--small" href="#install">Install</a>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-sheet" aria-label="Menu" data-menu>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="nav__progress" aria-hidden="true"></div>
  <nav class="nav__sheet" id="nav-sheet" aria-label="Site" data-sheet hidden>
    <a href="#try" style="--i:0">Try it</a>
    <a href="#persist" style="--i:1">Features</a>
    <a href="#security" style="--i:2">Security</a>
    <a href="#themes" style="--i:3">Themes</a>
    <a href="#compare" style="--i:4">Compare</a>
    <a href="#install" style="--i:5">Install</a>
    <a href={DOCS} style="--i:6">Docs</a>
    <a href={GITHUB} style="--i:7">GitHub</a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: 68px;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--motion-enter) var(--ease),
      border-color var(--motion-enter) var(--ease),
      backdrop-filter var(--motion-enter) var(--ease);
  }

  /* Glass once there is something under it to read through. Blur is for
     chrome, never for text — the app's rule, and this is chrome. */
  .nav[data-scrolled] {
    background: color-mix(in srgb, var(--ground) 74%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-code);
  }

  .nav__name {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .nav__version {
    padding: 3px 7px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.7rem;
    line-height: 1;
  }

  .nav__links {
    display: flex;
    gap: 26px;
    margin-left: 8px;
    font: 500 0.86rem / 1 var(--font-code);
  }

  .nav__links a,
  .nav__github {
    color: var(--text-muted);
    transition: color var(--motion-quick) var(--ease);
  }

  .nav__links a:hover,
  .nav__github:hover {
    color: var(--text);
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
  }

  .nav__github {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 0.86rem / 1 var(--font-code);
  }

  .nav__github svg {
    width: 18px;
    height: 18px;
  }

  /* How far down the page you are, drawn in the emblem's light. Pure CSS
     where the browser can tie an animation to scrolling; absent where not. */
  .nav__progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    background: var(--glow);
    transform-origin: 0 50%;
    transform: scaleX(0);
    opacity: 0;
  }

  @supports (animation-timeline: scroll()) {
    .nav__progress {
      opacity: 1;
      animation: nav-progress linear both;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes nav-progress {
    to {
      transform: scaleX(1);
    }
  }

  .nav__menu {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 38px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: 9px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  .nav__menu span {
    display: block;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text);
    transition: transform var(--motion-normal) var(--ease);
  }

  .nav__menu[aria-expanded="true"] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav__menu[aria-expanded="true"] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .nav__sheet {
    position: fixed;
    inset: 68px 0 0;
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 24px var(--gutter);
    background: color-mix(in srgb, var(--ground) 98%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .nav__sheet[hidden] {
    display: none;
  }

  .nav__sheet a {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font: 700 1.6rem / 1.2 var(--font-code);
    letter-spacing: -0.03em;
    animation: sheet-in 420ms var(--out-expo) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 760px) {
    .nav__menu {
      display: inline-flex;
    }

    .nav__links,
    .nav__version,
    .nav__github span {
      display: none;
    }

    .nav__end {
      gap: 10px;
    }
  }

  /* A phone's bar holds the mark, the theme and Install; GitHub is in the
     footer and one tap away there. */
  @media (max-width: 480px) {
    .nav__github {
      display: none;
    }

    .nav__name {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLButtonElement>("[data-menu]");
  const sheet = document.querySelector<HTMLElement>("[data-sheet]");
  if (menu && sheet) {
    const set = (open: boolean) => {
      sheet.hidden = !open;
      menu.setAttribute("aria-expanded", String(open));
      document.documentElement.style.overflow = open ? "hidden" : "";
    };
    menu.addEventListener("click", () => set(sheet.hidden));
    sheet.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !sheet.hidden) {
        set(false);
        menu.focus();
      }
    });
  }

  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    let raf = 0;
    const update = () => {
      raf = 0;
      nav.toggleAttribute("data-scrolled", window.scrollY > 8);
    };
    update();
    window.addEventListener(
      "scroll",
      () => {
        if (!raf) raf = requestAnimationFrame(update);
      },
      { passive: true },
    );
  }
</script>
