---
import { doc } from "../lib/links";

const history = ["docker ps", "docker compose up -d", "git push origin main", "kubectl get pods", "pnpm run dev"];
const month = Array.from({ length: 35 }, (_, i) => i - 2); // a five-week grid, starting two days in
const apps = [
  ["GitHub", "device-code sign-in"],
  ["Gmail", "read-only"],
  ["Browser", "native webview"],
  ["Weather", ""],
  ["News", ""],
  ["Map", ""],
  ["Calculator", ""],
  ["Timer", ""],
];
---

<section class="sx" id="sections" aria-labelledby="sections-title">
  <div class="wrap">
    <div class="sx__head">
      <h2 class="heading" id="sections-title" data-split>One window. Ten sections.</h2>
      <p class="lead">Everything a working day in a terminal reaches for, in one window — each part loaded only when you open it.</p>
    </div>

    <div class="sx__grid" data-reveal="children">
      <!-- Terminal -->
      <article class="sx__card sx__card--terminal" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">❯</span><h3>Terminal</h3></header>
        <p>Real PTYs with tabs and 2D splits, WebGL2 rendering, shells that outlive the window, Sixel and iTerm2 images.</p>
        <div class="sx__splits" aria-hidden="true">
          <div class="sx__pane">
            <span class="t-accent">~/api $</span> cargo test
            <span class="sx__out" style="--d:0">running 42 tests</span>
            <span class="sx__out" style="--d:0.6">test pty::resize ... ok</span>
            <span class="sx__out" style="--d:1.1">test detach::rejoin ... ok</span>
            <span class="sx__out t-mint" style="--d:1.6">test result: ok. 42 passed</span>
          </div>
          <div class="sx__pane">
            <span class="t-accent">~/web $</span> pnpm dev
            <span class="sx__out" style="--d:0.5">VITE ready in 312 ms</span>
            <span class="sx__out t-muted" style="--d:1.2">➜ Local: http://localhost:5173</span>
            <span class="sx__out" style="--d:2">hmr update /src/App.svelte</span>
            <span class="sx__out" style="--d:2.6">hmr update /src/routes/+page.svelte</span>
          </div>
          <div class="sx__pane sx__pane--wide">
            <span class="t-accent">~ $</span> htop
            <span class="sx__cpu"><i style="--c:62%"></i><i style="--c:38%"></i><i style="--c:81%"></i><i style="--c:24%"></i></span>
          </div>
        </div>
      </article>

      <!-- History -->
      <article class="sx__card sx__card--history" data-spotlight data-history>
        <header><span class="sx__icon" aria-hidden="true">↺</span><h3>History & Work Memory</h3></header>
        <p>Fuzzy search ranked by recency and frequency — and search inside what every run printed.</p>
        <div class="sx__search" aria-hidden="true">
          <div class="sx__query"><span class="t-accent">⌕</span> <span data-q>dkrps</span><i class="sx__caret"></i></div>
          <ul class="sx__results" data-results>
            {history.map((h) => <li data-cmd={h}>{h}</li>)}
          </ul>
        </div>
      </article>

      <!-- Editor -->
      <article class="sx__card" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">✎</span><h3>Editor</h3></header>
        <p>CodeMirror 6, multi-root, with image and PDF previews.</p>
        <pre class="sx__code" aria-hidden="true"><span class="t-magenta">fn</span> <span class="t-accent">main</span>() {"{"}
  <span class="t-magenta">let</span> shell = <span class="t-warn">Pty</span>::spawn()?;
  shell.<span class="t-accent">detach</span>();
{"}"}</pre>
      </article>

      <!-- Remote -->
      <article class="sx__card" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">⇄</span><h3>Remote</h3></header>
        <p>SSH hosts from your <code>~/.ssh/config</code>, host-key fingerprints, never a stored password.</p>
        <ul class="sx__hosts" aria-hidden="true">
          <li><i></i>prod-api <span>SHA256:x8kQ…3fA</span></li>
          <li><i></i>staging <span>SHA256:m2Pd…9wE</span></li>
        </ul>
      </article>

      <!-- Assistant -->
      <article class="sx__card" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">✦</span><h3>Assistant</h3></header>
        <p>Anthropic, OpenAI or a local Ollama model. Reading is free; running waits for you.</p>
        <div class="sx__ask" aria-hidden="true">
          <code>lsof -i :8080</code>
          <span class="sx__approve">Approve</span>
        </div>
      </article>

      <!-- Workspaces -->
      <article class="sx__card" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">▦</span><h3>Workspaces</h3></header>
        <p>Named setups — folders, terminals, an SSH host — switched in one step. Plus Git worktrees.</p>
        <div class="sx__ws" aria-hidden="true"><span class="is-on">api</span><span>web</span><span>infra</span></div>
      </article>

      <!-- Games -->
      <article class="sx__card sx__card--games" data-spotlight>
        <header>
          <span class="sx__icon" aria-hidden="true">◈</span><h3>Games</h3>
          <span class="sx__score" aria-live="off">score <b data-score>0</b></span>
        </header>
        <p>Dino Run, Snake, Tic-Tac-Toe, Flappy Bird and 2048. This Snake plays itself — click it, then steer with the arrow keys.</p>
        <canvas class="sx__snake" tabindex="0" aria-label="Snake: playing itself. Focus it and use the arrow keys or swipe to take over." data-snake></canvas>
      </article>

      <!-- Dashboard -->
      <article class="sx__card" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">⌂</span><h3>Dashboard</h3></header>
        <p>Notes, todos, a calendar and reminders — stored locally, scriptable with <code>jky note</code>.</p>
        <div class="sx__cal" aria-hidden="true">
          {month.map((d) => <span class:list={{ "is-off": d < 1 || d > 31, "is-today": d === 8 }}>{d < 1 ? d + 30 : d > 31 ? d - 31 : d}</span>)}
        </div>
      </article>

      <!-- Developer -->
      <article class="sx__card" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">⌥</span><h3>Developer</h3></header>
        <p>Twelve tools: JSON, YAML, diff, hashes, JWT, regex, HTTP, ports, DNS and more.</p>
        <code class="sx__jwt" aria-hidden="true"><span class="t-magenta">eyJhbGciOiJIUzI1NiJ9</span>.<span class="t-accent">eyJzdWIiOiJqa3kifQ</span>.<span class="t-mint">Sm9obiBEb2U</span></code>
      </article>

      <!-- Apps -->
      <article class="sx__card sx__card--apps" data-spotlight>
        <header><span class="sx__icon" aria-hidden="true">⊞</span><h3>Apps</h3></header>
        <p>GitHub and a read-only Gmail, a native browser, and the small things — each fetched by Rust, never by the window.</p>
        <ul class="sx__apps">
          {apps.map(([name, note]) => <li><b>{name}</b>{note && <span>{note}</span>}</li>)}
        </ul>
      </article>
    </div>
    <a class="story__more sx__more" href={doc("README.md")}>Every section, in depth</a>
  </div>
</section>

<style>
  .sx {
    padding-top: var(--section-gap);
  }

  .sx__head {
    display: grid;
    gap: 20px;
    max-width: 820px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .sx__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .sx__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
    transition: border-color var(--motion-normal) var(--ease);
  }

  /* The pointer's light, across the card and along its edge. */
  .sx__card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(320px circle at var(--mx, -400px) var(--my, -400px), var(--accent-glow), transparent 70%);
  }

  .sx__card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .sx__card header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sx__card h3 {
    margin: 0;
    font: 650 1.02rem / 1.2 var(--font-code);
    letter-spacing: -0.015em;
  }

  .sx__icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    color: var(--accent);
    font: 15px/1 var(--font-code);
  }

  .sx__card > p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-small);
    line-height: 1.5;
  }

  .sx__card code {
    color: var(--accent);
    font-size: 0.86em;
  }

  .sx__card--terminal {
    grid-column: span 2;
    grid-row: span 2;
  }

  .sx__card--history,
  .sx__card--apps {
    grid-column: span 2;
  }

  .sx__card--games {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* Terminal: three panes, working. */
  .sx__splits {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr auto;
    gap: 6px;
    min-height: 220px;
    margin-top: 6px;
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--ground);
  }

  .sx__pane {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font: 11.5px/1.5 var(--font-code);
    color: var(--text);
  }

  .sx__pane:first-child {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }

  .sx__pane--wide {
    grid-column: span 2;
  }

  .sx__out {
    animation: sx-out 6s var(--ease) infinite;
    animation-delay: calc(var(--d) * 1s);
  }

  @keyframes sx-out {
    0%,
    8% {
      opacity: 0;
      transform: translateY(4px);
    }
    14%,
    90% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  .sx__cpu {
    display: grid;
    gap: 4px;
    margin-top: 4px;
  }

  .sx__cpu i {
    height: 6px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--mint), var(--accent)) 0 0 / var(--c) 100% no-repeat, var(--surface-raised);
    animation: sx-cpu 2.4s var(--ease) infinite alternate;
  }

  .sx__cpu i:nth-child(2) {
    animation-delay: -0.8s;
  }

  .sx__cpu i:nth-child(3) {
    animation-delay: -1.6s;
  }

  @keyframes sx-cpu {
    to {
      background-size:
        calc(var(--c) * 0.55) 100%,
        auto;
    }
  }

  /* History: fuzzy search. */
  .sx__search {
    display: grid;
    gap: 8px;
    margin-top: 4px;
    font: 12px/1.5 var(--font-code);
  }

  .sx__query {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 12px;
    border: 1px solid var(--accent);
    border-radius: 9px;
    background: var(--ground);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .sx__caret {
    width: 7px;
    height: 14px;
    background: var(--accent);
    animation: jky-caret 1s steps(1) infinite;
  }

  .sx__results {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sx__results li {
    padding: 4px 12px;
    border-radius: 7px;
    color: var(--text-muted);
    transition:
      opacity var(--motion-normal) var(--ease),
      background-color var(--motion-normal) var(--ease);
  }

  .sx__results li.is-hit {
    color: var(--text);
  }

  .sx__results li.is-best {
    background: var(--surface-raised);
  }

  .sx__results li.is-miss {
    opacity: 0.25;
  }

  /* Created by the script at run time, so outside this component's scope. */
  .sx__results :global(mark) {
    background: none;
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sx__code {
    margin: 4px 0 0;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--ground);
    color: var(--text);
    font: 11.5px/1.6 var(--font-code);
    white-space: pre;
    overflow: hidden;
  }

  .sx__hosts {
    display: grid;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font: 11.5px/1.4 var(--font-code);
  }

  .sx__hosts li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
  }

  .sx__hosts i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
  }

  .sx__hosts span {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 10.5px;
  }

  .sx__ask {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
    padding: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--ground);
  }

  .sx__approve {
    padding: 5px 10px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--ground);
    font: 600 11px/1 var(--font-code);
    animation: sx-pulse 2.4s var(--ease) infinite;
  }

  @keyframes sx-pulse {
    50% {
      box-shadow: 0 0 0 5px var(--accent-glow);
    }
  }

  .sx__ws {
    display: flex;
    gap: 6px;
    margin-top: 4px;
  }

  .sx__ws span {
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    color: var(--text-muted);
    font: 500 12px/1 var(--font-code);
    animation: sx-ws 6s steps(1) infinite;
  }

  .sx__ws span:nth-child(2) {
    animation-delay: -4s;
  }

  .sx__ws span:nth-child(3) {
    animation-delay: -2s;
  }

  @keyframes sx-ws {
    0% {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--accent-glow);
    }
    33% {
      border-color: var(--line-strong);
      color: var(--text-muted);
      background: transparent;
    }
  }

  .sx__score {
    margin-left: auto;
    color: var(--text-muted);
    font: 500 12px/1 var(--font-code);
  }

  .sx__score b {
    color: var(--accent);
  }

  .sx__snake {
    flex: 1;
    width: 100%;
    min-height: 220px;
    margin-top: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--ground);
    cursor: pointer;
    touch-action: none;
  }

  .sx__snake:focus-visible {
    outline-offset: 2px;
  }

  .sx__cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
    margin-top: 4px;
    font: 10px/1 var(--font-code);
    text-align: center;
  }

  .sx__cal span {
    padding: 5px 0;
    border-radius: 5px;
    color: var(--text-muted);
  }

  .sx__cal .is-off {
    opacity: 0.35;
  }

  .sx__cal .is-today {
    background: var(--accent);
    color: var(--ground);
    font-weight: 700;
  }

  .sx__jwt {
    display: block;
    margin-top: 4px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--ground);
    font: 11px/1.5 var(--font-code);
    word-break: break-all;
  }

  .sx__apps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .sx__apps li {
    display: grid;
    gap: 2px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--ground);
    font: 12px/1.3 var(--font-code);
  }

  .sx__apps b {
    color: var(--text);
    font-weight: 600;
  }

  .sx__apps span {
    color: var(--text-muted);
    font-size: 10.5px;
  }

  .sx__more {
    display: inline-block;
    margin-top: 22px;
  }

  @media (max-width: 1080px) {
    .sx__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .sx__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .sx__card--terminal,
    .sx__card--history,
    .sx__card--apps,
    .sx__card--games {
      grid-column: auto;
      grid-row: auto;
    }

    .sx__apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { spotlight, startMotion, still } from "../lib/motion";
  import { autopilot, newGame, step, turn, type Dir, type Game } from "../lib/snake";

  startMotion();
  spotlight(".sx__card");
  const reduce = still();

  // ---- History: dkrps finds docker ps -----------------------------------------
  const hist = document.querySelector<HTMLElement>("[data-history]");
  if (hist) {
    const q = hist.querySelector<HTMLElement>("[data-q]");
    const items = [...hist.querySelectorAll<HTMLLIElement>("[data-cmd]")];
    const QUERY = "dkrps";
    const match = (text: string, query: string) => {
      const marks: number[] = [];
      let at = 0;
      for (const ch of query) {
        const i = text.indexOf(ch, at);
        if (i < 0) return null;
        marks.push(i);
        at = i + 1;
      }
      return marks;
    };
    const render = (query: string) => {
      if (q) q.textContent = query;
      let best: HTMLLIElement | null = null;
      for (const li of items) {
        const cmd = li.dataset.cmd ?? "";
        const m = query ? match(cmd, query) : [];
        li.classList.toggle("is-miss", m === null);
        li.classList.toggle("is-hit", !!m && query.length > 0);
        li.classList.remove("is-best");
        if (m && query.length && !best) best = li;
        li.replaceChildren(...[...cmd].map((ch, i) => (m?.includes(i) && query ? Object.assign(document.createElement("mark"), { textContent: ch }) : ch)));
      }
      best?.classList.add("is-best");
    };
    if (reduce) render(QUERY);
    else {
      let n = 0;
      let visible = false;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(hist);
      setInterval(() => {
        if (!visible) return;
        n = (n + 1) % (QUERY.length + 5);
        render(QUERY.slice(0, Math.min(n, QUERY.length)));
      }, 380);
    }
  }

  // ---- Snake -------------------------------------------------------------------
  const canvas = document.querySelector<HTMLCanvasElement>("[data-snake]");
  const scoreEl = document.querySelector<HTMLElement>("[data-score]");
  if (canvas) {
    const ctx = canvas.getContext("2d");
    const COLS = 24;
    const ROWS = 14;
    let game: Game = newGame(COLS, ROWS);
    let manual = false;
    let visible = false;
    let last = 0;
    let colors = { ground: "", accent: "", violet: "", magenta: "", line: "", text: "" };
    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors = {
        ground: s.getPropertyValue("--ground").trim(),
        accent: s.getPropertyValue("--accent").trim(),
        violet: s.getPropertyValue("--violet").trim(),
        magenta: s.getPropertyValue("--magenta").trim(),
        line: s.getPropertyValue("--line").trim(),
        text: s.getPropertyValue("--text-muted").trim(),
      };
    };
    const size = () => {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(r.width * dpr);
      canvas.height = Math.round(r.height * dpr);
    };
    const draw = () => {
      if (!ctx) return;
      const w = canvas.width;
      const h = canvas.height;
      const cell = Math.min(w / COLS, h / ROWS);
      const ox = (w - cell * COLS) / 2;
      const oy = (h - cell * ROWS) / 2;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = colors.line;
      for (let y = 0; y < ROWS; y++) for (let x = 0; x < COLS; x++) ctx.fillRect(ox + x * cell + cell / 2 - 1, oy + y * cell + cell / 2 - 1, 2, 2);
      // Food: a magenta spark.
      ctx.shadowBlur = cell * 0.8;
      ctx.shadowColor = colors.magenta;
      ctx.fillStyle = colors.magenta;
      ctx.beginPath();
      ctx.arc(ox + (game.food.x + 0.5) * cell, oy + (game.food.y + 0.5) * cell, cell * 0.3, 0, Math.PI * 2);
      ctx.fill();
      // The snake: the emblem's light, head to tail.
      game.snake.forEach((p, i) => {
        const t = i / Math.max(1, game.snake.length - 1);
        ctx.fillStyle = t < 0.5 ? colors.accent : colors.violet;
        ctx.shadowColor = ctx.fillStyle;
        ctx.shadowBlur = i === 0 ? cell : cell * 0.3;
        const pad = i === 0 ? cell * 0.08 : cell * 0.14;
        ctx.beginPath();
        ctx.roundRect(ox + p.x * cell + pad, oy + p.y * cell + pad, cell - pad * 2, cell - pad * 2, cell * 0.25);
        ctx.fill();
      });
      ctx.shadowBlur = 0;
      if (game.over) {
        ctx.fillStyle = colors.text;
        ctx.font = `${Math.round(cell * 0.9)}px "JetBrains Mono Variable", monospace`;
        ctx.textAlign = "center";
        ctx.fillText(manual ? "game over — click to play again" : "", w / 2, h / 2);
      }
      if (scoreEl) scoreEl.textContent = String(game.score);
    };
    const tick = (now: number) => {
      if (!visible) return;
      requestAnimationFrame(tick);
      const interval = manual ? 110 : 85;
      if (now - last < interval) return;
      last = now;
      if (game.over) {
        if (!manual) game = newGame(COLS, ROWS);
        draw();
        return;
      }
      if (!manual) turn(game, autopilot(game));
      step(game);
      draw();
    };
    const keys: Record<string, Dir> = {
      ArrowUp: "up", ArrowDown: "down", ArrowLeft: "left", ArrowRight: "right",
      w: "up", s: "down", a: "left", d: "right",
    };
    canvas.addEventListener("keydown", (e) => {
      const dir = keys[e.key];
      if (!dir) return;
      e.preventDefault();
      manual = true;
      turn(game, dir);
    });
    canvas.addEventListener("pointerdown", () => {
      canvas.focus();
      if (game.over) game = newGame(COLS, ROWS);
      manual = true;
    });
    let touch: { x: number; y: number } | null = null;
    canvas.addEventListener("touchstart", (e) => (touch = { x: e.touches[0].clientX, y: e.touches[0].clientY }), { passive: true });
    canvas.addEventListener("touchmove", (e) => {
      if (!touch) return;
      const dx = e.touches[0].clientX - touch.x;
      const dy = e.touches[0].clientY - touch.y;
      if (Math.abs(dx) + Math.abs(dy) < 24) return;
      manual = true;
      turn(game, Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? "right" : "left") : dy > 0 ? "down" : "up");
      touch = null;
    }, { passive: true });
    canvas.addEventListener("blur", () => {
      manual = false;
    });
    readColors();
    size();
    draw();
    new ResizeObserver(() => {
      size();
      draw();
    }).observe(canvas);
    window.addEventListener("jky:theme", () => {
      readColors();
      draw();
    });
    if (!reduce) {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) requestAnimationFrame(tick);
      }).observe(canvas);
    }
  }
</script>
