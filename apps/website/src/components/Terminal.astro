</style>

<script>
  import { mountTerminal } from "../lib/terminal/view";

  const root = document.querySelector<HTMLElement>("[data-terminal]");
  if (root) {
    const version = root.querySelector(".term__ver")?.textContent?.replace(/^v/, "") ?? "";
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // The window rises as it comes into view; the shell wakes up with it.
    const rise = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        root.classList.add("is-in");
        rise.disconnect();
      },
      { threshold: 0.12 },
    );
    rise.observe(root);
    mountTerminal(root, { version, still });
  }
</script>
