---
import { inline, readComparison, type Mark } from "../lib/readme";
import { doc } from "../lib/links";

const c = readComparison();
const label: Record<Mark, string> = {
  yes: "built in",
  partly: "partly, or with setup",
  no: "not offered",
  unknown: "not verified for this table",
  text: "",
};
---

<section class="cmp" id="compare" aria-labelledby="compare-title">
  <div class="wrap">
    <div class="cmp__head">
      <h2 class="heading" id="compare-title" data-split>How JKY compares. Honestly.</h2>
      <p class="lead">
        Every terminal here is excellent at something, and most are far more mature than JKY. This is to help you choose,
        not to win — checked against each project's own docs in October 2026, with blanks where nothing was verified.
      </p>
    </div>

    <div class="cmp__legend" aria-hidden="true">
      <span><i class="m m--yes"></i> built in</span>
      <span><i class="m m--partly"></i> partly, or with setup</span>
      <span><i class="m m--no"></i> not offered, often by design</span>
      <span><i class="m m--unknown">—</i> not verified</span>
    </div>

    <div class="cmp__scroll" tabindex="0" role="region" aria-label="Comparison table — scrolls sideways">
      <table class="cmp__table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            {c.columns.map((col, i) => <th scope="col" class:list={{ "is-jky": i === 0 }}>{col}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            c.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.cells.map((cell, i) => (
                  <td class:list={{ "is-jky": i === 0 }}>
                    {cell.mark === "text" ? (
                      <span class="cmp__text">{cell.note}</span>
                    ) : (
                      <span class="cmp__cell">
                        <i class={`m m--${cell.mark}`} aria-hidden="true">
                          {cell.mark === "unknown" ? "—" : ""}
                        </i>
                        <span class="sr-only">{label[cell.mark]}</span>
                        {cell.note && <span class="cmp__note">{cell.note}</span>}
                      </span>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="cmp__sides" data-reveal="children">
      <div class="cmp__side cmp__side--good">
        <h3>Where JKY is different</h3>
        <ul>{c.different.map((b) => <li set:html={inline(b)} />)}</ul>
      </div>
      <div class="cmp__side cmp__side--behind">
        <h3>Where JKY is behind today</h3>
        <ul>{c.behind.map((b) => <li set:html={inline(b)} />)}</ul>
      </div>
    </div>
    <a class="story__more cmp__more" href={doc("comparison.md")}>The full comparison, with every source</a>
  </div>
</section>

<style>
  .cmp {
    padding-top: var(--section-gap);
  }

  .cmp__head {
    display: grid;
    gap: 20px;
    max-width: 880px;
    margin-bottom: 28px;
  }

  .cmp__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-bottom: 18px;
    color: var(--text-muted);
    font: 500 0.8rem / 1 var(--font-code);
  }

  .cmp__legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cmp__scroll {
    overflow-x: auto;
    /* Keep the sticky table's overflow inside this scroller on mobile. */
    contain: layout paint;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) var(--surface);
    overscroll-behavior-x: contain;
  }

  .cmp__table {
    width: 100%;
    min-width: 860px;
    border-collapse: separate;
    border-spacing: 0;
    font: 500 0.86rem / 1.3 var(--font-code);
  }

  .cmp__table th,
  .cmp__table td {
    padding: 13px 14px;
    border-bottom: 1px solid var(--line);
    text-align: center;
    vertical-align: middle;
    transition: background-color 180ms var(--ease);
  }

  .cmp__table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .cmp__table thead th {
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  .cmp__table th[scope="row"] {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--surface);
    color: var(--text);
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
  }

  .cmp__table tbody tr:hover > * {
    background: color-mix(in srgb, var(--surface-raised) 70%, var(--surface));
  }

  /* JKY's column carries the emblem's light down its length. */
  .cmp__table .is-jky {
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
    box-shadow:
      inset 1px 0 0 color-mix(in srgb, var(--accent) 45%, transparent),
      inset -1px 0 0 color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .cmp__table thead .is-jky {
    color: var(--accent);
    box-shadow:
      inset 1px 0 0 color-mix(in srgb, var(--accent) 45%, transparent),
      inset -1px 0 0 color-mix(in srgb, var(--accent) 45%, transparent),
      inset 0 2px 0 var(--accent);
  }

  .cmp__cell {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .cmp__note,
  .cmp__text {
    color: var(--text-muted);
    font-size: 0.74rem;
    white-space: nowrap;
  }

  .cmp__text {
    color: var(--text);
  }

  .m {
    display: inline-grid;
    place-items: center;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    font-style: normal;
  }

  .m--yes {
    background: var(--mint);
    box-shadow: 0 0 10px color-mix(in srgb, var(--mint) 60%, transparent);
  }

  .m--partly {
    background: linear-gradient(90deg, var(--warn) 50%, transparent 50%);
    box-shadow: inset 0 0 0 1.5px var(--warn);
  }

  .m--no {
    box-shadow: inset 0 0 0 1.5px var(--text-muted);
  }

  .m--unknown {
    width: auto;
    height: auto;
    color: var(--text-muted);
  }

  .cmp__sides {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 18px;
  }

  .cmp__side {
    padding: clamp(20px, 2.6vw, 30px);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
  }

  .cmp__side--good {
    border-color: color-mix(in srgb, var(--mint) 35%, var(--line));
  }

  .cmp__side--behind {
    border-color: color-mix(in srgb, var(--warn) 35%, var(--line));
  }

  .cmp__side h3 {
    margin: 0 0 14px;
    font: 650 1.05rem / 1.3 var(--font-code);
  }

  .cmp__side--good h3 {
    color: var(--mint);
  }

  .cmp__side--behind h3 {
    color: var(--warn);
  }

  .cmp__side ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 18px;
    color: var(--text-muted);
    font-size: var(--t-small);
    line-height: 1.55;
  }

  .cmp__side :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .cmp__side :global(code) {
    color: var(--accent);
    font-size: 0.9em;
  }

  .cmp__side :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cmp__more {
    display: inline-block;
    margin-top: 22px;
  }

  @media (max-width: 760px) {
    .cmp__sides {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The feature column wraps on a phone, so the columns it is compared
       across get the width. */
    .cmp__table {
      min-width: 700px;
      font-size: 0.8rem;
    }

    .cmp__table th[scope="row"] {
      min-width: 128px;
      max-width: 140px;
      white-space: normal;
    }
  }
</style>

<script>
  import { startMotion } from "../lib/motion";
  startMotion();
</script>
