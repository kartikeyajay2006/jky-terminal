---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Terminal from "../components/Terminal.astro";
import Proof from "../components/Proof.astro";
import StoryPersist from "../components/StoryPersist.astro";
import StoryPanels from "../components/StoryPanels.astro";
import StoryAssistant from "../components/StoryAssistant.astro";
import Security from "../components/Security.astro";
import Themes from "../components/Themes.astro";
import Sections from "../components/Sections.astro";
import Compare from "../components/Compare.astro";
import Install from "../components/Install.astro";
import Finale from "../components/Finale.astro";
import Footer from "../components/Footer.astro";
import release from "../data/release.json";

const version = release.tag.replace(/^v/, "");
---

<Base
  title="JKY Terminal — close the window, the build keeps going"
  description="A local-first terminal for macOS, Windows and Linux. Shells that survive closing the app, command output that becomes panels, and an assistant that asks before it acts. Open source, no account, no telemetry."
>
  <Nav version={version} />
  <main id="main">
    <Hero version={version} />
    <Terminal version={version} />
    <Proof />
    <StoryPersist />
    <StoryPanels />
    <StoryAssistant />
    <Security />
    <Themes />
    <Sections />
    <Compare />
    <Install />
    <Finale />
  </main>
  <Footer />
</Base>
