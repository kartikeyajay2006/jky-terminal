---
/**
 * The share card: what a link to the site shows on social media and in
 * chat. A 1200 × 630 page that scripts/og.mjs screenshots into public/og.png
 * — the same emblem, in the same characters, as the hero.
 */
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "../styles/global.css";
import Emblem from "../components/Emblem.astro";
import Wordmark from "../components/Wordmark.astro";
---

<!doctype html>
<html lang="en" data-theme="cyberpunk">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>JKY Terminal — share card</title>
  </head>
  <body class="og">
    <div class="og__card" data-og>
      <canvas class="og__field" data-field></canvas>
      <div class="og__emblem" data-emblem><Emblem /></div>
      <div class="og__text">
        <span class="og__wordmark"><Wordmark /></span>
        <h1 class="display og__title">Close the window.<br /><span>The build keeps going.</span></h1>
        <p class="og__sub">The open-source terminal for macOS, Windows and Linux that keeps your shells alive.</p>
      </div>
    </div>
  </body>
</html>

<style>
  body.og {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  .og__card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background:
      radial-gradient(640px 520px at 78% 50%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      var(--ground);
  }

  .og__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .og__emblem {
    position: absolute;
    top: 50%;
    right: 40px;
    width: 560px;
    aspect-ratio: 1;
    translate: 0 -50%;
    opacity: 0;
  }

  .og__text {
    position: absolute;
    left: 72px;
    top: 70px;
    display: grid;
    gap: 26px;
    width: 640px;
  }

  .og__wordmark {
    display: block;
    width: 210px;
  }

  .og__title {
    font-size: 64px;
    color: var(--text-muted);
  }

  .og__title span {
    color: var(--text);
  }

  .og__sub {
    margin: 0;
    max-width: 30ch;
    color: var(--text-muted);
    font-size: 25px;
    line-height: 1.4;
  }
</style>

<script>
  import { startGlyphField } from "../lib/glyphfield/field";

  const card = document.querySelector<HTMLElement>("[data-og]");
  const canvas = card?.querySelector<HTMLCanvasElement>("[data-field]");
  const emblem = card?.querySelector<HTMLElement>("[data-emblem]");
  if (card && canvas && emblem) {
    void startGlyphField(canvas, { emblem, surface: card, still: true }).then((field) => {
      document.documentElement.dataset.ready = field ? "glyphs" : "vector";
      if (!field) emblem.style.opacity = "1";
    });
  }
</script>
